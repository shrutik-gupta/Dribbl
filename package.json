{
  "name": "dribbl",
  "version": "2.0.0",
  "private": true,
  "description": "Dribbl: weekly turf football organiser, sign-ups, fair teams, live score, peer ratings, UPI payments and stats.",
  "type": "module",
  "scripts": {
    "dev": "npx serve public -l 5173",
    "check": "find public/js -name '*.js' -exec node --check {} +",
    "deploy": "firebase deploy",
    "deploy:site": "firebase deploy --only hosting",
    "apk": "sh scripts/build-apk.sh"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2"
  }
}
