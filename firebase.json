{
  "hosting": {
    "site": "dribbl",
    "public": "public",
    "ignore": ["**/.*", "download/**"],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
