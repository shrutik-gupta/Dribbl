{
  "hosting": {
    "site": "dribbl",
    "public": "public",
    "ignore": ["**/.*"],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "download/*.apk",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "Content-Type", "value": "application/vnd.android.package-archive" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
